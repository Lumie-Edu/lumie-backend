<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <!-- Dev: human-readable console output -->
    <springProfile name="default,dev,local">
        <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

    <!-- Prod: structured JSON output -->
    <springProfile name="prod">
        <appender name="JSON_CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <includeMdcKeyName>tenantSlug</includeMdcKeyName>
                <includeMdcKeyName>tenantId</includeMdcKeyName>
                <includeMdcKeyName>userId</includeMdcKeyName>
                <includeMdcKeyName>userRole</includeMdcKeyName>
                <includeMdcKeyName>requestId</includeMdcKeyName>
                <includeMdcKeyName>traceId</includeMdcKeyName>
                <includeMdcKeyName>eventType</includeMdcKeyName>
                <includeMdcKeyName>outcome</includeMdcKeyName>
                <includeMdcKeyName>httpMethod</includeMdcKeyName>
                <includeMdcKeyName>httpPath</includeMdcKeyName>
                <includeMdcKeyName>httpStatus</includeMdcKeyName>
                <includeMdcKeyName>latencyMs</includeMdcKeyName>
                <includeMdcKeyName>actorId</includeMdcKeyName>
                <includeMdcKeyName>actorName</includeMdcKeyName>
                <includeMdcKeyName>actorRole</includeMdcKeyName>
                <includeMdcKeyName>action</includeMdcKeyName>
                <includeMdcKeyName>entityType</includeMdcKeyName>
                <includeMdcKeyName>entityId</includeMdcKeyName>
                <includeMdcKeyName>entityName</includeMdcKeyName>
                <includeMdcKeyName>jobId</includeMdcKeyName>
                <includeMdcKeyName>jobName</includeMdcKeyName>
                <includeMdcKeyName>jobPhase</includeMdcKeyName>
                <includeMdcKeyName>queue</includeMdcKeyName>
                <includeMdcKeyName>routingKey</includeMdcKeyName>
                <includeMdcKeyName>dependency</includeMdcKeyName>
                <includeMdcKeyName>operation</includeMdcKeyName>
                <includeMdcKeyName>externalStatus</includeMdcKeyName>
                <timeZone>UTC</timeZone>
                <shortenedLoggerNameLength>36</shortenedLoggerNameLength>
            </encoder>
        </appender>
        <root level="INFO">
            <appender-ref ref="JSON_CONSOLE"/>
        </root>
    </springProfile>
</configuration>
