# Development image for remote BuildKit + Tilt live updates.
#
# Tilt syncs Java source/resources into this workspace and recompiles them
# in-place. The container starts the compiled classpath directly so Spring Boot
# DevTools can restart the application without a Gradle JVM competing for the
# Pod's memory. Production continues to use Dockerfile's immutable bootJar.
FROM zot.lumie-infra.com/library/eclipse-temurin:21-jdk@sha256:5f42d89380984fc2d16f42dfeb97f7221dfb29697223c4d773455dbf4af30de6

WORKDIR /workspace

RUN chown ubuntu:ubuntu /workspace

COPY --chown=ubuntu:ubuntu . .

USER ubuntu

ENV GRADLE_USER_HOME=/workspace/.gradle
ENV JAVA_OPTS="-XX:+UseG1GC -Xmx450m"
ENV TILT_GRADLE_JVM_ARGS="-Dorg.gradle.jvmargs=-Xmx512m -Dorg.gradle.workers.max=2"

# Prime the Gradle cache and verify the initial development classpath while the
# remote BuildKit cache is warm. Subsequent source edits are incremental.
RUN ./gradlew $TILT_GRADLE_JVM_ARGS :devClasses :app:writeDevRuntimeClasspath --no-daemon

EXPOSE 8080

ENTRYPOINT ["sh", "-c", "exec java $JAVA_OPTS -cp \"$(cat /workspace/app/build/dev-runtime-classpath)\" com.lumie.app.LumieApplication"]
