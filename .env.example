## lumie-backend environment variables
## Copy to .env for local dev (Tilt injects these into the k3s pod).
## Secrets without defaults MUST be set — the app will fail to start otherwise.

# Spring profile
SPRING_PROFILES_ACTIVE=dev

# PostgreSQL (via PgBouncer in dev, direct in prod)
DB_HOST=pgbouncer.lumie-dev.svc.cluster.local
DB_PORT=5432
DB_NAME=lumie
DB_USERNAME=lumie_app
DB_PASSWORD=changeme

# Read-only replica
RO_DB_HOST=lumie-dev-db-rw.lumie-dev.svc.cluster.local
RO_DB_PORT=5432
RO_DB_NAME=lumie
RO_DB_USERNAME=lumie_app
RO_DB_PASSWORD=changeme

# Flyway migrator (Postgres superuser — only used at startup)
DB_MIGRATOR_USERNAME=lumie
DB_MIGRATOR_PASSWORD=changeme

# RabbitMQ
RABBITMQ_HOST=rabbitmq-dev.lumie-dev.svc.cluster.local
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=lumie
RABBITMQ_PASSWORD=changeme

# Redis
REDIS_HOST=redis-dev-master.lumie-dev.svc.cluster.local
REDIS_PORT=6379

# JWT
JWT_SECRET_KEY=changeme-min-32-chars-secret-key
JWT_ACCESS_EXPIRATION=3600
JWT_REFRESH_EXPIRATION=604800

# Internal HMAC (BE → worker calls)
LUMIE_INTERNAL_HMAC_SECRET=changeme

# MinIO
MINIO_ENDPOINT=minio.lumie-infra.svc.cluster.local:9000
MINIO_ACCESS_KEY=changeme
MINIO_SECRET_KEY=changeme
MINIO_BUCKET_NAME=lumie-dev
MINIO_EXTERNAL_ENDPOINT=https://dev.lumie-infra.com

# OAuth providers
GOOGLE_CLIENT_ID=changeme
GOOGLE_CLIENT_SECRET=changeme
GOOGLE_REDIRECT_URI=https://dev.lumie-infra.com/api/auth/v1/oauth2/google/callback
KAKAO_CLIENT_ID=changeme
KAKAO_CLIENT_SECRET=changeme
KAKAO_REDIRECT_URI=https://dev.lumie-infra.com/api/auth/v1/oauth2/kakao/callback
NAVER_REDIRECT_URI=https://dev.lumie-infra.com/api/auth/v1/oauth2/naver/callback

# Worker service URLs
GRADING_SVC_URL=http://grading-svc.lumie-dev.svc:8000
REPORT_SVC_URL=http://report-svc.lumie-dev.svc:8000

# Frontend callback (OAuth)
FRONTEND_CALLBACK_URL=https://dev.lumie-infra.com/auth/callback

# AI API keys (optional features)
DEEPSEEK_API_KEY=changeme
GEMINI_API_KEY=changeme
